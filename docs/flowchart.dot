digraph G {
  rankdir=TB;
  node [shape=box, style="rounded", fontname="Arial", fontsize=11];
  start [shape=oval, label="Start / Load Sample Data"];
  menu [label="Display Menu"];
  choice [shape=diamond, label="Select Operation"];
  reg [label="Register Member\nStudent / Faculty"];
  book [label="Add / Update / Search Book"];
  issue [label="Issue Book\nCheck member limit + stock"];
  ret [label="Return Book\nUpdate stock + calculate fine"];
  reserve [label="Reserve / Cancel\nWaitlist management"];
  notify [label="Notification Thread\nDue / Overdue alerts"];
  concurrent [label="Concurrent Issue Demo\nPriority + synchronized + wait/notifyAll"];
  report [label="Generate Reports\nCirculation + utilization"];
  exit [shape=oval, label="Exit"];
  start -> menu -> choice;
  choice -> reg [label="1"];
  choice -> book [label="2-5"];
  choice -> issue [label="6"];
  choice -> ret [label="7"];
  choice -> reserve [label="8-9, 15"];
  choice -> notify [label="12"];
  choice -> concurrent [label="13"];
  choice -> report [label="3, 10-11, 14"];
  choice -> exit [label="0"];
  reg -> menu; book -> menu; issue -> menu; ret -> menu; reserve -> menu; notify -> menu; concurrent -> menu; report -> menu;
}
